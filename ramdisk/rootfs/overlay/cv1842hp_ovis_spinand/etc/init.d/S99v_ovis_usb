#!/bin/sh

USB_GADGET=/tmp/usb/usb_gadget/cvitek

start_usb() {
	count=0
	while [ ! -e /var/run/ovis-mpp-ready ] ||
	      [ ! -c /dev/soph-vi ] || [ ! -c /dev/soph-vpss ] ||
	      [ ! -c /dev/soph-rgn ]; do
		if [ "$count" -ge 50 ]; then
			echo "OVIS MPP readiness timeout" >&2
			return 1
		fi
		sleep 0.1
		count=$((count + 1))
	done
	attempt=1
	action=late-start
	while [ "$attempt" -le 3 ]; do
		echo "OVIS USB startup attempt $attempt"
		sh /etc/init.d/S77ncm "$action"
		status=$?
		if [ "$status" -eq 0 ]; then
			if [ -s "$USB_GADGET/UDC" ]; then
				echo "OVIS USB ready at $(cut -d ' ' -f 1 /proc/uptime)s"
				return 0
			fi
			echo "OVIS USB lost the UDC binding after startup" >&2
		fi
		attempt=$((attempt + 1))
		action=restart
		[ "$attempt" -le 3 ] && sleep 0.2
	done
	echo "OVIS USB startup failed after 3 attempts" >&2
	return 1
}

case "$1" in
	start)
		start_usb
		;;
	stop)
		exec /etc/init.d/S77ncm stop
		;;
	restart|reload)
		exec /etc/init.d/S77ncm restart
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
