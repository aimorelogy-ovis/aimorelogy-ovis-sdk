#!/bin/sh

# Keep this service after S99user: the MPP kernel modules must finish probing
# before ipcamera creates VI, VPSS, and VENC channels.

APP_DIR=/usr/share/ipcamera
DAEMON="$APP_DIR/ipcamera"
MANAGER=/usr/sbin/ovis-managerd
PARAM_CONFIG=/mnt/cfg/ipcamera/param_config.ini
PIDFILE=/var/run/ipcamera.pid
READYFILE=${IPCAMERA_READY_FILE:-/var/run/ipcamera.ready}
NCM_ADDRESS_FILE=/var/run/ovis-ncm-address
START_TIMEOUT=${IPCAMERA_START_TIMEOUT:-20}
STOP_TIMEOUT=15

read_pid() {
	[ -r "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE")
	case "$pid" in
		''|*[!0-9]*) return 1 ;;
	esac
}

pid_is_ipcamera() {
	pid=$1
	kill -0 "$pid" 2>/dev/null || return 1
	if [ "$(readlink "/proc/$pid/exe" 2>/dev/null)" = "$DAEMON" ]; then
		return 0
	fi
	[ -r "/proc/$pid/cmdline" ] || return 1
	[ "$(tr '\000' '\n' < "/proc/$pid/cmdline" | sed -n '1p')" = "$DAEMON" ]
}

find_running_pid() {
	for proc in /proc/[0-9]*; do
		candidate=${proc##*/}
		if pid_is_ipcamera "$candidate"; then
			pid=$candidate
			printf '%s\n' "$pid" > "$PIDFILE"
			return 0
		fi
	done
	return 1
}

is_running() {
	if read_pid && pid_is_ipcamera "$pid"; then
		return 0
	fi
	find_running_pid
}

prepare_config() {
	if [ -x "$MANAGER" ]; then
		"$MANAGER" --prepare-config
		return $?
	fi
	mkdir -p /mnt/cfg/ipcamera || return 1
	[ -s "$PARAM_CONFIG" ] && return 0
	cp "$APP_DIR/param_config.ini" "$PARAM_CONFIG"
}

start() {
	[ -x "$DAEMON" ] || return 0
	if [ ! -s "$NCM_ADDRESS_FILE" ]; then
		echo "ipcamera start deferred until the OVIS USB network is configured"
		return 0
	fi
	if is_running; then
		if [ -e "$READYFILE" ]; then
			echo "ipcamera is already running and ready (PID $pid)"
			return 0
		fi
		echo "ipcamera is running but not ready (PID $pid)"
		return 1
	fi
	rm -f "$PIDFILE" "$READYFILE"
	prepare_config || {
		echo "ipcamera parameter config is unavailable"
		return 1
	}
	cd "$APP_DIR" || return 1
	[ -e /var/run/ovis-mpp-ready ] || {
		echo "ipcamera requires initialized MPP modules" >&2
		return 1
	}
	printf 'Starting ipcamera: %s -i %s\n' "$DAEMON" "$PARAM_CONFIG"
	# Keep application output off the manager's finite command-output pipe.
	"$DAEMON" -i "$PARAM_CONFIG" </dev/null >/dev/console 2>&1 &
	pid=$!
	echo "$pid" > "$PIDFILE"
	count=0
	while [ "$count" -lt "$((START_TIMEOUT * 10))" ]; do
		if ! kill -0 "$pid" 2>/dev/null; then
			rm -f "$PIDFILE" "$READYFILE"
			echo "ipcamera exited during startup"
			return 1
		fi
		if [ -e "$READYFILE" ]; then
			echo "ipcamera started and ready (PID $pid)"
			return 0
		fi
		sleep 0.1
		count=$((count + 1))
	done
	echo "ipcamera readiness timeout"
	stop
	return 1
}

stop() {
	printf "Stopping ipcamera: "
	if ! is_running; then
		rm -f "$PIDFILE" "$READYFILE"
		echo "not running"
		return 0
	fi
	count=0
	while is_running && [ "$count" -lt "$STOP_TIMEOUT" ]; do
		kill -TERM "$pid" 2>/dev/null || {
			echo "FAIL"
			return 1
		}
		sleep 1
		count=$((count + 1))
	done
	if is_running; then
		echo "FAIL (timeout waiting for PID $pid)"
		return 1
	fi
	rm -f "$PIDFILE" "$READYFILE"
	echo "OK"
}

status() {
	if is_running; then
		echo "ipcamera is running (PID $pid)"
		return 0
	fi
	read_pid && rm -f "$PIDFILE"
	rm -f "$READYFILE"
	echo "ipcamera is not running"
	return 1
}

case "$1" in
	start|stop|status)
		"$1"
		;;
	restart|reload)
		stop && start
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload|status}"
		exit 1
		;;
esac
