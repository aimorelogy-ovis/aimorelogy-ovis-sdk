SHELL = /bin/bash
#
ifeq ($(PARAM_FILE), )
PARAM_FILE:=../../../Makefile.param
include $(PARAM_FILE)
endif
#
# include ../../self_test.mk
include $(MW_PATH)/modules/audio/audio_config.mk
#
SDIR = $(CURDIR)
SRCS = $(wildcard $(SDIR)/*.c)
INCS = -I$(MW_INC) -I../common/ -I$(CURDIR)/include
OBJS = $(SRCS:.c=.o)
DEPS = $(SRCS:.c=.d)
#
TARGET = cvi_mp3player
#
EXTRA_CFLAGS = $(INCS)
EXTRA_LDFLAGS += -lmad -lcvi_audio
EXTRA_LDFLAGS +=  -lm -lpthread  -ldl -lcvi_mp3 -lcvi_VoiceEngine
EXTRA_LDFLAGS +=  -lcvi_vqe -ltinyalsa -lcvi_RES1
ifeq ($(TARGET_MACHINE), arm-linux-gnueabihf)
EXTRA_LDFLAGS += -L $(CURDIR)/libmad/lib_32
ifeq ($(SAMPLE_STATIC),1)
LIB_DEP := $(CURDIR)/libmad/lib_32/libmad.a
else
LIB_DEP := $(CURDIR)/libmad/lib_32/libmad.so
endif
endif
#
ifeq ($(TARGET_MACHINE), aarch64-linux-gnu)
EXTRA_LDFLAGS += -L $(CURDIR)/libmad/lib_64
ifeq ($(SAMPLE_STATIC),1)
LIB_DEP := $(CURDIR)/libmad/lib_64/libmad.a
else
LIB_DEP := $(CURDIR)/libmad/lib_64/libmad.so
endif
endif
#
ifeq ($(USE_SONIC_LIB), yes)
EXTRA_CFLAGS += -DUSE_SONIC_LIB
endif


.PHONY : clean all
all : $(TARGET)

$(SDIR)/%.o : $(SDIR)/%.c
	@$(CC) $(DEPFLAGS) $(CFLAGS) $(EXTRA_CFLAGS) -o $@ -c $<
	@echo [$(notdir $(CC))] $(notdir $@)

$(TARGET) : $(OBJS) $(LIB_DEP)
	@$(CXX) -o $@ $(OBJS) $(ELFFLAGS) $(EXTRA_LDFLAGS)
	@echo -e $(BLUE)[LINK]$(END)[$(notdir $(CC))] $(notdir $@)

clean:
	@rm -f $(OBJS) $(DEPS) $(TARGET)

-include $(DEPS)
