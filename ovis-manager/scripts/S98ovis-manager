#!/bin/sh

DAEMON=/usr/sbin/ovis-managerd
IDENTITY_HELPER=/usr/sbin/ovis-device-identity
PIDFILE=/var/run/ovis-manager.pid
READYFILE=/var/run/ovis-manager.ready
STATE_DIR=/mnt/cfg/ovis-manager
ACCOUNT_FILE="$STATE_DIR/ovis.account"
OLD_CREDENTIALS="$STATE_DIR/credentials"
LOGFILE=/var/log/ovis-manager.log
NCM_ADDRESS_FILE=/var/run/ovis-ncm-address

is_running() {
	[ -r "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE")
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start() {
	[ -x "$DAEMON" ] || return 0
	if [ ! -s "$NCM_ADDRESS_FILE" ]; then
		echo "ovis-manager start deferred until the NCM subnet is configured"
		return 0
	fi
	if is_running; then
		echo "ovis-manager is already running (PID $pid)"
		return 0
	fi
	rm -f "$PIDFILE" "$READYFILE"
	mkdir -p "$STATE_DIR" || return 1
	[ -x "$IDENTITY_HELPER" ] || return 1
	device_id=$("$IDENTITY_HELPER") || return 1
	echo "OVIS device ID: $device_id"
	account_username=$(sed -n 's/^username=//p' "$ACCOUNT_FILE" 2>/dev/null)
	account_password=$(sed -n 's/^password=//p' "$ACCOUNT_FILE" 2>/dev/null)
	if [ "$account_username" != "admin" ] || [ -z "$account_password" ]; then
		username=admin
		password=
		if [ -s "$OLD_CREDENTIALS" ]; then
			credential=$(sed -n '1p' "$OLD_CREDENTIALS")
			case "$credential" in
				*:* )
					password=${credential#*:}
					;;
			esac
		fi
		if [ -z "$username" ] || [ -z "$password" ]; then
			username=admin
			password=$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')
			[ -n "$password" ] || return 1
		fi
		umask 077
		printf 'username=%s\npassword=%s\n' "$username" "$password" > "$ACCOUNT_FILE" || return 1
		echo "OVIS manager initial account: $username / $password"
		echo "OVIS manager account created: $ACCOUNT_FILE"
		echo "Use 'cat $ACCOUNT_FILE' to view the account."
	fi
	chmod 600 "$ACCOUNT_FILE"
	if [ -s "$ACCOUNT_FILE" ]; then
		rm -f "$OLD_CREDENTIALS"
	fi
	printf "Starting ovis-manager: "
	OVIS_MANAGER_READY_FILE="$READYFILE" "$DAEMON" </dev/null >> "$LOGFILE" 2>&1 &
	pid=$!
	echo "$pid" > "$PIDFILE"
	count=0
	while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 100 ]; do
		if [ "$(cat "$READYFILE" 2>/dev/null)" = "$pid" ]; then
			echo "OK"
			return 0
		fi
		sleep 0.1
		count=$((count + 1))
	done
	kill "$pid" 2>/dev/null
	rm -f "$PIDFILE" "$READYFILE"
	echo "FAIL"
	return 1
}

stop() {
	rm -f "$READYFILE"
	printf "Stopping ovis-manager: "
	if ! is_running; then
		rm -f "$PIDFILE"
		echo "not running"
		return 0
	fi
	kill "$pid" 2>/dev/null || return 1
	count=0
	while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do
		sleep 1
		count=$((count + 1))
	done
	if kill -0 "$pid" 2>/dev/null; then
		echo "FAIL (timeout)"
		return 1
	fi
	rm -f "$PIDFILE"
	echo "OK"
}

case "$1" in
	start|stop)
		"$1"
		;;
	restart)
		stop && start
		;;
	status)
		if is_running; then
			echo "ovis-manager is running (PID $pid)"
		else
			echo "ovis-manager is not running"
			exit 1
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
