#!/bin/sh

DAEMON=/usr/sbin/ovis-managerd
PIDFILE=/var/run/ovis-manager.pid
STATE_DIR=/mnt/cfg/ovis-manager
ACCOUNT_FILE="$STATE_DIR/ovis.account"
DEVICE_ID_FILE="$STATE_DIR/device-id"
OLD_CREDENTIALS="$STATE_DIR/credentials"
LOGFILE=/var/log/ovis-manager.log

is_running() {
	[ -r "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE")
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

ensure_device_id() {
	device_id=$(sed -n '1p' "$DEVICE_ID_FILE" 2>/dev/null)
	case "$device_id" in
		OVIS-*)
			case "$device_id" in
				*[!A-Za-z0-9-]*) device_id= ;;
			esac
			;;
		*) device_id= ;;
	esac
	[ "${#device_id}" -ge 13 ] 2>/dev/null || device_id=
	if [ -z "$device_id" ]; then
		device_suffix=$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')
		[ "${#device_suffix}" -eq 16 ] || return 1
		device_id="OVIS-1842-$device_suffix"
		umask 077
		printf '%s\n' "$device_id" > "$DEVICE_ID_FILE" || return 1
		echo "OVIS device ID created: $device_id"
	fi
	chmod 600 "$DEVICE_ID_FILE"
}

start() {
	[ -x "$DAEMON" ] || return 0
	if is_running; then
		echo "ovis-manager is already running (PID $pid)"
		return 0
	fi
	rm -f "$PIDFILE"
	mkdir -p "$STATE_DIR" || return 1
	ensure_device_id || return 1
	account_username=$(sed -n 's/^username=//p' "$ACCOUNT_FILE" 2>/dev/null)
	account_password=$(sed -n 's/^password=//p' "$ACCOUNT_FILE" 2>/dev/null)
	if [ "$account_username" != "admin" ] || [ -z "$account_password" ]; then
		username=admin
		password=
		if [ -s "$OLD_CREDENTIALS" ]; then
			credential=$(sed -n '1p' "$OLD_CREDENTIALS")
			case "$credential" in
				*:* )
					password=${credential#*:}
					;;
			esac
		fi
		if [ -z "$username" ] || [ -z "$password" ]; then
			username=admin
			password=$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')
			[ -n "$password" ] || return 1
		fi
		umask 077
		printf 'username=%s\npassword=%s\n' "$username" "$password" > "$ACCOUNT_FILE" || return 1
		echo "OVIS manager initial account: $username / $password"
		echo "OVIS manager account created: $ACCOUNT_FILE"
		echo "Use 'cat $ACCOUNT_FILE' to view the account."
	fi
	chmod 600 "$ACCOUNT_FILE"
	if [ -s "$ACCOUNT_FILE" ]; then
		rm -f "$OLD_CREDENTIALS"
	fi
	printf "Starting ovis-manager: "
	"$DAEMON" >> "$LOGFILE" 2>&1 &
	pid=$!
	echo "$pid" > "$PIDFILE"
	sleep 1
	if kill -0 "$pid" 2>/dev/null; then
		echo "OK"
		return 0
	fi
	rm -f "$PIDFILE"
	echo "FAIL"
	return 1
}

stop() {
	printf "Stopping ovis-manager: "
	if ! is_running; then
		rm -f "$PIDFILE"
		echo "not running"
		return 0
	fi
	kill "$pid" 2>/dev/null || return 1
	count=0
	while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do
		sleep 1
		count=$((count + 1))
	done
	if kill -0 "$pid" 2>/dev/null; then
		echo "FAIL (timeout)"
		return 1
	fi
	rm -f "$PIDFILE"
	echo "OK"
}

case "$1" in
	start|stop)
		"$1"
		;;
	restart)
		stop && start
		;;
	status)
		if is_running; then
			echo "ovis-manager is running (PID $pid)"
		else
			echo "ovis-manager is not running"
			exit 1
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
