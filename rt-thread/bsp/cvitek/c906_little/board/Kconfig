        select RT_USING_WDT
        default n
        help
            C906L can only use WDT2

        if BSP_USING_WDT
            config BSP_USING_WDT2
                bool "Enable WDT2"
                default n
        endif

    menuconfig BSP_USING_TIMER
        bool "Enable TIMER"
        default n
        select RT_USING_HWTIMER
        help
            C906L can only use TIMER6/TIMER7

        if BSP_USING_TIMER
            config BSP_USING_TIMER6
                bool "Enable TIMER6"
                default n

            config BSP_USING_TIMER7
                bool "Enable TIMER7"
                default n

            config BSP_TIMER_IRQ_BASE
                int
                default 59
        endif

