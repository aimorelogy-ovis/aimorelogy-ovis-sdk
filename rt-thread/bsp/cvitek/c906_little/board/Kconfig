        default n

        if BSP_USING_SELFTEST
            config BSP_TEST_GPIO
                bool "Enable GPIO_SELFTEST"
                default n
            config BSP_TEST_SPI
                bool "Enable SPI_SELFTEST"
                default n
            config BSP_TEST_TPU
                bool "Enable TPU_SELFTEST"
                default n
            config BSP_TEST_UART
                bool "Enable BSP_TEST_UART"
                default n
            config BSP_TEST_SD
                bool "Enable BSP_TEST_SD"
                default n
            config BSP_TEST_WDT
                bool "Enable BSP_TEST_WDT"
                default n
            config BSP_TEST_TIMER
                bool "Enable BSP_TEST_TIMER"
                default n
            config BSP_TEST_ADC
                bool "Enable BSP_TEST_ADC"
                default n
            config BSP_TEST_PWM
                bool "Enable BSP_TEST_PWM"
                default n
            config BSP_TEST_RTC
                bool "Enable BSP_TEST_RTC"
                default n
            config BSP_TEST_DMA
                bool "Enable BSP_TEST_DMA"
                default n
        endif

    config BSP_USING_MAILBOX
        bool "Enable Mailbox"
        default y
        if BSP_USING_MAILBOX
            config BSP_MAILBOX_IRQ_BASE
                int
                default 61
        endif

