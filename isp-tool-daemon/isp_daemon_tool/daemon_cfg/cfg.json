{
	"//": "------------------------------------------------------------",
	"//": "more option please refer https://wiki.sophgo.com/x/E34YCg",
	"//": "------------------------------------------------------------",
	"//": "compress-mode none,tile,line,frame",
	"//": "we set venc-bind-vpss=1 can cost down vb blk",
	"//": "bitstream-buf-size can set venc buffer size",
	"//": "vi-vpss-mode 0.VI_OFFLINE_VPSS_OFFLINE 1.VI_OFFLINE_VPSS_ONLINE",
	"//": "vi-vpss-mode 4.VI_ONLINE_VPSS_OFFLINE  5.VI_ONLINE_VPSS_ONLINE",
	"//": "when it is wdr mode or dual sensor, we cant't set VI_ONLINE_VPSS_OFFLINE/VI_ONLINE_VPSS_ONLINE",
	"//": "if run sbm mode, set vi-vpss-mode 1 set venc-bind-vpss true",
	"dev-num": 1,
	"rtsp-port": 8554,
	"rtsp-max-buf-size": 10485760,
	"rtsp-server-select": 3,
	"vi-vpss-mode": 1,
	"max-use-tpu-num": 1,
	"teaisp-faceae-model": "./cvi_models/retinaface_mnet0.25_342_608.cvimodel",
	"teaisp-pq-model": "./cvi_models/aipq_sym_mars_BF16.cvimodel",
	"replay-mode": false,
	"replay-param": "./replay.json",
	"enable-stitch": false,
	"stitch-param": "./stitch_param.json",
	"cvi-bin-path": "/mnt/cfg/param",
	"sensor-cfg-ini": "/mnt/data/sensor_cfg.ini",
	"sbm": 0,
	"sbm-buf-line": 64,
	"sbm-buf-size": 16,
	"is_fastboot_mode": false,
	"enable_dump_boot_video": false,
	"video-src-info": [
		{
			"chn": 0,
			"buf-blk-cnt": 4,
			"tpu-device-id": 0,
			"venc-bind-vpss": false,
			"enable-isp-info-osd": false,
			"enable-faceae": false,
			"enable-teaisp-pq": false,
			"enable-teaisp-bnr": false,
			"teaisp_model_list": "./cvi_models/teaisp_bnr_model_list.txt",
			"venc_json": "./vc_param.json",
			"codec": "265",
			"compress-mode": "tile"
		},
		{
			"chn": 1,
			"buf-blk-cnt": 1,
			"tpu-device-id": 0,
			"venc-bind-vpss": false,
			"enable-isp-info-osd": false,
			"enable-faceae": false,
			"enable-teaisp-pq": false,
			"enable-teaisp-bnr": false,
			"teaisp_model_list": "./cvi_models/teaisp_bnr_model_list.txt",
			"venc_json": "./vc_param.json",
			"codec": "265",
			"compress-mode": "tile"
		}
	]
}
