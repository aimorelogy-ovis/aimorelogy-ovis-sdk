/dts-v1/;
#include "cv184x_base_arm.dtsi"
#include "cv184x_asic_bga.dtsi"
#include "cv184x_asic_spinand.dtsi"
#include "cv184x_default_memmap.dtsi"

/ {
	aliases {
		spi0 = &spi0;
		spi3 = &spi3;
	};
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

&i2c3 {
	status = "okay";
};

&spi0 {
	status = "okay";
};

&spi3 {
	status = "okay";
	num-cs = <1>;

	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};
